# Copiar a .env y ajustar.
# DATABASE_URL / DIRECT_URL salen de Neon (neon.tech): panel del proyecto → botón "Connect".
#   DATABASE_URL = connection string CON pooling activo (el host termina en "-pooler") — runtime.
#   DIRECT_URL   = connection string directa (host SIN "-pooler") — solo migraciones.
DATABASE_URL="postgresql://usuario:password@ep-xxx-pooler.us-east-2.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://usuario:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require"

# Generar uno nuevo por entorno (nunca reusar el mismo en dev y producción): npx auth secret
AUTH_SECRET="generar-uno-nuevo-con-npx-auth-secret"
AUTH_TRUST_HOST=true
