# Copiar a .env y ajustar.
# DATABASE_URL / DIRECT_URL salen de Supabase: Project Settings → Database → Connection string.
#   DATABASE_URL = modo "Transaction" (puerto 6543, pooled) — usado en runtime.
#   DIRECT_URL   = modo "Session"/"Direct connection" (puerto 5432) — usado solo en migraciones.
DATABASE_URL="postgresql://usuario:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://usuario:password@host:5432/postgres"

# Generar uno nuevo por entorno (nunca reusar el mismo en dev y producción): npx auth secret
AUTH_SECRET="generar-uno-nuevo-con-npx-auth-secret"
AUTH_TRUST_HOST=true
