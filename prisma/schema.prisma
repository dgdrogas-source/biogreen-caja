// Módulo Nequi — Sistema de caja Biogreen
// PostgreSQL (Supabase). Los enums se modelan como String validados con Zod.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // conexión pooled (Transaction, 6543) — runtime
  directUrl = env("DIRECT_URL")   // conexión directa (Session, 5432) — solo migraciones
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String
  passwordHash String
  role         String // ADMIN | WORKER
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  movements              Movement[]
  auditLogs              AuditLog[]
  closedDays             BusinessDay[]
  pocketTransfers        PocketTransfer[]
  cierresGenerales       CierreGeneral[]
  ventasCredito          VentaCredito[]
  abonosCredito          AbonoCredito[]
  closureDifferences     ClosureDifference[]
  closureDifferenceResoluciones ClosureDifferenceResolution[]
  mensualDias            MensualDia[]
  tarjetaAbonos          TarjetaAbono[]
  plataformaTransferencias PlataformaTransferencia[]
}

// Un registro por TURNO de caja (2 turnos por día, lunes-sábado). Las filas
// anteriores a los turnos quedaron como turno 1 de su día.
model BusinessDay {
  id                     String    @id @default(cuid())
  date                   String // YYYY-MM-DD (zona America/Bogota)
  shift                  Int       @default(1) // 1 | 2
  openingBalance         Int? // saldo Nequi al iniciar el turno (heredado del cierre real anterior)
  closingRealBalance     Int? // saldo real ingresado por el dueño al cerrar
  closingExpectedBalance Int? // snapshot del saldo esperado al cerrar (para calcular el descuadre)
  status                 String    @default("OPEN") // OPEN | CLOSED
  closedAt               DateTime?
  closedById             String?
  closedBy               User?     @relation(fields: [closedById], references: [id])
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  movements     Movement[]
  auditLogs     AuditLog[]
  cierreGeneral CierreGeneral?

  @@unique([date, shift])
}

// Horarios de los turnos (editables desde Configuración). Solo definen el turno
// POR DEFECTO al registrar; no re-asignan movimientos ya guardados.
model ShiftConfig {
  shift     Int      @id // 1 | 2
  startTime String // "HH:MM" (America/Bogota)
  endTime   String // "HH:MM"
  updatedAt DateTime @updatedAt
}

model Movement {
  id            String  @id @default(cuid())
  businessDayId String
  businessDay   BusinessDay @relation(fields: [businessDayId], references: [id])

  // VENTA_FARMACIA | ABONO_CREDITO | RETIRO_CLIENTE | CONSIGNACION_CLIENTE | COMISION
  // | VENTA_FUXION | VENTA_LICORES_JHOANN | PAGO_FACTURA | GASTO_FARMACIA
  // | PENDIENTE_OTRO | IMPUESTO_4X1000
  type          String
  direction     String // INCOME | EXPENSE
  amount        Int // pesos colombianos (sin centavos)
  paymentMethod String // NEQUI | EFECTIVO
  note          String?

  registeredById String
  registeredBy   User     @relation(fields: [registeredById], references: [id])
  registeredAt   DateTime @default(now())

  isSystemGenerated     Boolean @default(false) // true para el 4x1000 automático
  // comisión -> retiro/consignación que la originó; impuesto -> movimiento que lo generó
  sourceMovementId      String?
  sourceMovement        Movement?  @relation("Derived", fields: [sourceMovementId], references: [id])
  derivedMovements      Movement[] @relation("Derived")
  needsReclassification Boolean    @default(false) // true si type=PENDIENTE_OTRO

  // Bolsillos organizativos: "COMISION", "LICORES_JHOANN", "FUXION", "BASE_FACTURAS", o null.
  // Entra: automático para VENTA_* + manual para GASTO/PAGO_FACTURA.
  // Sale: al marcar movimientos como pagados desde ese bolsillo.
  // NO afecta el cuadre de Nequi (puro organizativo).
  pettyCashBucket String?

  deletedAt DateTime? // soft delete: nunca se borra físicamente
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  auditLogs AuditLog[]

  @@index([businessDayId, deletedAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  movementId    String?
  movement      Movement? @relation(fields: [movementId], references: [id])
  businessDayId String?
  businessDay   BusinessDay? @relation(fields: [businessDayId], references: [id])
  action        String // CREATE | UPDATE | DELETE | CLOSE_DAY | REOPEN_DAY | SET_BASE
  changedById   String
  changedBy     User     @relation(fields: [changedById], references: [id])
  changedAt     DateTime @default(now())
  fieldChanges  String? // JSON { campo: { before, after } }

  @@index([changedAt])
}

// Historial de transferencias entre bolsillos (reclasificación interna, no afecta Nequi).
model PocketTransfer {
  id        String   @id @default(cuid())
  fromBucket String  // LICORES_JHOANN | FUXION | BASE_FACTURAS
  toBucket  String   // LICORES_JHOANN | FUXION | BASE_FACTURAS
  amount    Int
  createdById String
  createdBy User    @relation(fields: [createdById], references: [id])
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Base de trabajo para el servicio de retiros/consignaciones (registro único, id=1).
// La base total = efectivo + Nequi. El total solo cambia cuando el dueño lo edita;
// los retiros/consignaciones solo desplazan el reparto entre efectivo y Nequi.
model BaseFund {
  id           Int      @id @default(1)
  cashPortion  Int      @default(0)
  nequiPortion Int      @default(1110000)
  updatedAt    DateTime @updatedAt
}

// Config global del Cierre general (una sola fila, id=1). El % de reposición es editable
// por el admin en cualquier momento; su complemento (gastos/utilidad) = 100 − este. Al
// guardar un cierre se copia este % al cierre (CierreGeneral.porcentajeReposicion) para
// congelar el historial. puntoEquilibrio = venta diaria mínima de referencia (semáforo).
model CierreGeneralConfig {
  id                   Int      @id @default(1)
  porcentajeReposicion Int      @default(70)
  puntoEquilibrio      Int      @default(1100000)
  updatedAt            DateTime @updatedAt
}

// Saldo inicial manual por bolsillo (ajuste puntual del dueño, fuera de
// Movement/PocketTransfer). Solo existe fila para los bolsillos ajustados;
// los demás se tratan como 0 (ver getPockets()).
model PocketBalance {
  bucket          String   @id // COMISION | LICORES_JHOANN | FUXION | BASE_FACTURAS | PENDIENTE_OTRO
  openingBalance  Int      @default(0) // saldo inicial que cuenta como Nequi en el reparto por medio
  openingEfectivo Int      @default(0) // saldo inicial en efectivo (hoy solo lo usa Comisiones)
  updatedAt       DateTime @updatedAt
}

// "Cierre general" de la farmacia: un registro por turno (BusinessDay). Guarda la venta
// desglosada por medio de pago (de Dominium) y los flujos del cierre (facturas, gastos,
// retiro, consignación). El reparto 70/30, la utilidad y el cuadre se calculan en caliente
// (ver calculations/cierreGeneral.ts). No toca el módulo Nequi.
model CierreGeneral {
  id            String      @id @default(cuid())
  businessDayId String      @unique
  businessDay   BusinessDay @relation(fields: [businessDayId], references: [id])

  // Venta por medio de pago (esperado, de Dominium)
  ventaEfectivo      Int @default(0)
  ventaNequi         Int @default(0)
  ventaTarjeta       Int @default(0)
  ventaDaviplata     Int @default(0)
  ventaTransferencia Int @default(0)
  ventaCredito       Int @default(0)
  ventaOtro          Int @default(0)
  ventaSinFactura    Int @default(0)

  // Real (para el cuadre): por ahora el crítico es el efectivo contado
  realEfectivo Int?

  // Flujos del cierre
  // DEPRECADOS (Fase 2): ya no se escriben desde guardarCierreGeneral. Se conservan en la BD
  // para no perder el histórico de cierres guardados en Fase 1 (fallback de lectura, ver
  // calculations/cierreGeneralItems.ts → sumarConFallback). La fuente de verdad ahora son
  // gastoItems/facturaItems (itemizados, con categoría).
  facturasPagadas Int     @default(0) // @deprecated — usar facturaItems
  gastosVarios    Int     @default(0) // @deprecated — usar gastoItems
  retiroCierre    Int     @default(0) // efectivo retirado al cerrar
  descuadre       Int? // sobra/falta observado (manual)
  nota            String?
  consignado      Boolean @default(false) // marcado manual: ¿ya se hizo la consignación pendiente?

  // Snapshot del % de reposición vigente al guardar este cierre. "Congela el historial":
  // cambiar el % global (CierreGeneralConfig) NO altera cierres ya guardados; solo los
  // nuevos (o los que se re-guarden). Los cierres de Fase 1/2 quedan en 70 por el DEFAULT.
  porcentajeReposicion Int @default(70)

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gastoItems    CierreGeneralGasto[]
  facturaItems  CierreGeneralFactura[]
  diferencias   ClosureDifference[]
}

// ---------- Bolsas acumuladas 70/30 ----------
// Saldo inicial manual por bolsa (mismo patrón que PocketBalance.openingBalance, pero en
// tabla propia y aislada: NO reutiliza pockets.ts/POCKET_BUCKETS ni Movement, a propósito,
// para no arriesgar el módulo Nequi). El acumulado NO se persiste aquí: se calcula en caliente
// sumando reposicionNeta/utilidadDia de TODOS los CierreGeneral (ver calculations/bolsas.ts)
// más este openingBalance.
model BolsaGeneral {
  bucket         String   @id // REPOSICION | GASTOS_UTILIDAD
  openingBalance Int      @default(0)
  updatedAt      DateTime @updatedAt
}

// ---------- Gastos clasificados por categoría (editable por el admin) ----------
model CategoriaGasto {
  id        String   @id @default(cuid())
  nombre    String   @unique
  // "Eliminar" desactiva si la categoría ya tiene gastos asociados (protege el histórico);
  // se borra físicamente solo si nunca se usó.
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())

  gastos CierreGeneralGasto[]
}

// Gasto individual del turno. Reemplaza el input directo CierreGeneral.gastosVarios (deprecado).
// El total del turno = suma de estos items.
model CierreGeneralGasto {
  id              String         @id @default(cuid())
  cierreGeneralId String
  cierreGeneral   CierreGeneral  @relation(fields: [cierreGeneralId], references: [id], onDelete: Cascade)
  categoriaId     String
  categoria       CategoriaGasto @relation(fields: [categoriaId], references: [id])
  monto           Int
  descripcion     String?
  metodoPago      String? // EFECTIVO_CAJA | EFECTIVO_SOBRE | NEQUI | DAVIPLATA | DATAFONO | TRANSFERENCIA | DESCONTADO_ORIGEN | OTRO (null = EFECTIVO_CAJA)
  proveedorId     String? // Proveedor tipo GASTO (opcional: no todo gasto tiene un proveedor externo)
  proveedorRef    Proveedor?     @relation("ProveedorGastos", fields: [proveedorId], references: [id])
  // true = gasto creado por el sistema (hoy solo el 4% de tarjeta). Se re-ajusta solo al
  // re-guardar el cierre; la dueña no lo edita a mano (ver guardarCierreGeneral).
  autoGenerado    Boolean        @default(false)
  createdAt       DateTime       @default(now())

  @@index([cierreGeneralId])
  @@index([proveedorId])
}

// Factura de proveedor pagada, itemizada. Reemplaza CierreGeneral.facturasPagadas (deprecado).
model CierreGeneralFactura {
  id              String        @id @default(cuid())
  cierreGeneralId String
  cierreGeneral   CierreGeneral @relation(fields: [cierreGeneralId], references: [id], onDelete: Cascade)
  proveedor       String? // @deprecated — texto libre legado; usar proveedorId (Proveedor tipo COSTO)
  proveedorId     String?
  proveedorRef    Proveedor?    @relation("ProveedorFacturas", fields: [proveedorId], references: [id])
  monto           Int
  descripcion     String?
  metodoPago      String? // EFECTIVO | NEQUI | DAVIPLATA | TRANSFERENCIA | OTRO (null = se asume EFECTIVO)
  createdAt       DateTime      @default(now())

  @@index([cierreGeneralId])
  @@index([proveedorId])
}

// ---------- Proveedores (Costo/facturas y Gastos, editable por el admin) ----------
// Un proveedor es de UN tipo (COSTO o GASTO); si el dueño necesita el mismo nombre en ambos
// contextos, crea dos registros (2026-07-15, confirmado con el dueño). "Eliminar" desactiva
// si el proveedor ya tiene facturas/gastos asociados (protege el histórico); se borra
// físicamente solo si nunca se usó (mismo patrón que CategoriaGasto).
model Proveedor {
  id        String   @id @default(cuid())
  nombre    String
  tipo      String // COSTO | GASTO
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facturas CierreGeneralFactura[] @relation("ProveedorFacturas")
  gastos   CierreGeneralGasto[] @relation("ProveedorGastos")

  @@unique([nombre, tipo])
}

// ---------- Cuentas por cobrar por cliente ----------
model Cliente {
  id        String   @id @default(cuid())
  nombre    String
  telefono  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ventasCredito VentaCredito[]
  abonosCredito AbonoCredito[]
}

// date/shift son columnas sueltas (NO FK a BusinessDay a propósito): una venta a crédito se
// registra en cualquier momento del día, no atada al ciclo de apertura/cierre de turno de
// Nequi. El campo "Crédito" de CierreGeneral (venta por medio, de Dominium) sigue siendo un
// número de control aparte — no se fuerza a que cuadren exacto, son dos fuentes distintas.
// deletedAt = soft delete (mismo patrón que Movement), para poder editar/borrar sin perder auditoría.
model VentaCredito {
  id          String    @id @default(cuid())
  clienteId   String
  cliente     Cliente   @relation(fields: [clienteId], references: [id])
  monto       Int
  date        String // YYYY-MM-DD
  shift       Int // 1 | 2
  nota        String?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([clienteId])
  @@index([date])
}

model AbonoCredito {
  id          String    @id @default(cuid())
  clienteId   String
  cliente     Cliente   @relation(fields: [clienteId], references: [id])
  monto       Int
  medioPago   String // EFECTIVO | NEQUI | TARJETA | DAVIPLATA | TRANSFERENCIA | OTRO (nunca CREDITO)
  date        String
  shift       Int
  nota        String?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([clienteId])
  @@index([date])
}

// ---------- Registro de sobrante/faltante con resolución ----------
// Cuando hay diferencia en el cierre, se registra aquí con la razón y cómo se resolvió.
model ClosureDifference {
  id              String                      @id @default(cuid())
  cierreGeneralId String
  cierreGeneral   CierreGeneral               @relation(fields: [cierreGeneralId], references: [id], onDelete: Cascade)
  tipo            String // SOBRANTE | FALTANTE
  monto           Int
  razonProbable   String // enum: Cliente pagó por método incorrecto, Olvido abono crédito, Error facturación, Pago incorrecto, Otro
  descripcion     String? // notas libres del admin
  estado          String @default("PENDIENTE_RESOLUCION") // PENDIENTE_RESOLUCION | RESUELTO
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  resoluciones ClosureDifferenceResolution[]

  @@index([cierreGeneralId])
}

// Cómo se resolvió una diferencia (ej: mover dinero de una plataforma a otra).
model ClosureDifferenceResolution {
  id          String             @id @default(cuid())
  differenciaId String
  diferencia  ClosureDifference  @relation(fields: [differenciaId], references: [id], onDelete: Cascade)
  tipoAjuste  String // Transferencia entre métodos, Crear abono crédito, Registrar pago faltante, Otro
  detalles    String? // ej: "Pasar $20k de datáfono a Nequi"
  monto       Int
  confirmado  Boolean @default(false)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([differenciaId])
}

// ============================================================================
// MÓDULO CIERRE MENSUAL (independiente de Nequi y de Cierre general, a propósito).
// Modelo simple alimentado día a día. El "disponible para gastar" se calcula en
// caliente (ver src/modules/mensual/calculations/cierreMensual.ts). Todo el dinero
// son enteros de pesos (COP). Cada mes arranca de cero (incl. cartera): el resumen
// solo suma las filas cuya `date` cae en el mes consultado.
// ============================================================================

// Categorías de gasto PROPIAS del módulo mensual (separadas de CategoriaGasto del
// Cierre general, por decisión 2026-07-15). "Eliminar" desactiva si ya tiene gastos.
model MensualCategoriaGasto {
  id        String   @id @default(cuid())
  nombre    String   @unique
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())

  gastos MensualGasto[]
}

// Una fila por día del mes (unique por fecha). La dueña la alimenta a diario:
// venta real, comisión 4% (escrita a mano), 4x1000 y el snapshot de cartera a esa fecha.
model MensualDia {
  id              String   @id @default(cuid())
  date            String   @unique // YYYY-MM-DD (America/Bogota)
  ventaDia        Int      @default(0) // venta real del día
  comisionTarjeta Int      @default(0) // 4% del banco sobre ventas con tarjeta
  impuesto4x1000  Int      @default(0) // 0.4% sobre transferencias que salen de su cuenta
  carteraTotal    Int      @default(0) // total de créditos a esa fecha (snapshot)
  nota            String?
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  gastos      MensualGasto[]
  diferencias MensualDiferencia[]

  @@index([date])
}

// Gasto itemizado del día (categoría + monto). El total del mes = suma de estos.
model MensualGasto {
  id           String                @id @default(cuid())
  mensualDiaId String
  mensualDia   MensualDia            @relation(fields: [mensualDiaId], references: [id], onDelete: Cascade)
  categoriaId  String
  categoria    MensualCategoriaGasto @relation(fields: [categoriaId], references: [id])
  monto        Int
  descripcion  String?
  createdAt    DateTime              @default(now())

  @@index([mensualDiaId])
}

// Sobrante/faltante de uno de los 3 cierres (Nequi/Efectivo/Banco) en un día.
// disposicion aplica solo a FALTANTE: CUBRE_EMPLEADA (no afecta disponible) o
// DESCUENTA_DISPONIBLE (resta). null = pendiente de decidir (aún no descuenta).
model MensualDiferencia {
  id           String     @id @default(cuid())
  mensualDiaId String
  mensualDia   MensualDia @relation(fields: [mensualDiaId], references: [id], onDelete: Cascade)
  cierre       String // NEQUI | EFECTIVO | BANCO
  tipo         String // SOBRANTE | FALTANTE
  monto        Int // siempre positivo; el signo lo da `tipo`
  disposicion  String? // CUBRE_EMPLEADA | DESCUENTA_DISPONIBLE (solo FALTANTE)
  nota         String?
  createdAt    DateTime   @default(now())

  @@index([mensualDiaId])
}

// ============================================================================
// SALDOS POR PLATAFORMA (Cierre general, 2026-07-17). Ver el diseño en CLAUDE.md.
// El saldo de cada plataforma se calcula EN CALIENTE (calculations/plataformas.ts) sumando
// ventas/pagos/abonos/transferencias; estas tablas solo guardan lo que no se puede derivar.
// ============================================================================

// Saldo inicial manual por plataforma (mismo patrón que BolsaGeneral). Solo hay fila para
// las plataformas ajustadas; el resto se trata como 0.
model PlataformaSaldoInicial {
  plataforma     String   @id // SOBRE_BLANCO | NEQUI | BANCO | DAVIPLATA
  openingBalance Int      @default(0)
  updatedAt      DateTime @updatedAt
}

// Ledger de abonos de tarjeta confirmados por la dueña (el banco abona la venta en NETO —
// venta − 4% — al día siguiente, y puede abonar parcial). Cada clic de "ya llegó" es una
// fila. El pendiente = Σ(venta tarjeta × 96%) − Σ abonos (se calcula, no se guarda).
model TarjetaAbono {
  id          String   @id @default(cuid())
  date        String // YYYY-MM-DD en que la dueña confirma el abono
  monto       Int // neto que entró al banco (lo que ella ve en la app)
  nota        String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([date])
}

// Movimiento real de plata entre plataformas propias (ej. Banco → Nequi para juntar lo de
// facturas). El dinero llega COMPLETO; el 4x1000 se cobra aparte y reduce la plataforma
// origen (impuesto4x1000). Aislado a propósito de PocketTransfer del módulo Nequi.
model PlataformaTransferencia {
  id             String   @id @default(cuid())
  fromPlataforma String // SOBRE_BLANCO | NEQUI | BANCO | DAVIPLATA
  toPlataforma   String
  monto          Int
  impuesto4x1000 Int      @default(0) // 4x1000 que el banco cobró por el movimiento (reduce el origen)
  nota           String?
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())

  @@index([createdAt])
}
