// Módulo Nequi — Sistema de caja Biogreen
// PostgreSQL (Supabase). Los enums se modelan como String validados con Zod.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // conexión pooled (Transaction, 6543) — runtime
  directUrl = env("DIRECT_URL")   // conexión directa (Session, 5432) — solo migraciones
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String
  passwordHash String
  role         String // ADMIN | WORKER
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  movements              Movement[]
  auditLogs              AuditLog[]
  closedDays             BusinessDay[]
  pocketTransfers        PocketTransfer[]
  ventasCredito          VentaCredito[]
  abonosCredito          AbonoCredito[]
  mensualDias            MensualDia[]
  cierresDiarios         CierreDiario[]
  movimientosManualesCierreDiario CierreDiarioMovimientoManual[]
  licorCompras           LicorCompra[]
  licorVentas            LicorVenta[]
  licorAbonos            LicorAbono[]
  licorCierres           LicorCierre[]
  fuxionCompras          FuxionCompra[]
  fuxionVentas           FuxionVenta[]
  fuxionAbonos           FuxionAbono[]
  fuxionCierres          FuxionCierre[]
  partesRegistrados      ParteTurno[]  @relation("ParteRegistradoPor")
  partesAprobados        ParteTurno[]  @relation("ParteAprobadoPor")
}

// Un registro por TURNO de caja (2 turnos por día, lunes-sábado). Las filas
// anteriores a los turnos quedaron como turno 1 de su día.
model BusinessDay {
  id                     String    @id @default(cuid())
  date                   String // YYYY-MM-DD (zona America/Bogota)
  shift                  Int       @default(1) // 1 | 2
  openingBalance         Int? // saldo Nequi al iniciar el turno (heredado del cierre real anterior)
  closingRealBalance     Int? // saldo real ingresado por el dueño al cerrar
  closingExpectedBalance Int? // snapshot del saldo esperado al cerrar (para calcular el descuadre)
  status                 String    @default("OPEN") // OPEN | CLOSED
  closedAt               DateTime?
  closedById             String?
  closedBy               User?     @relation(fields: [closedById], references: [id])
  closingNote            String? // observación del cierre (motivo del descuadre, etc.); editable en cualquier momento
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  movements     Movement[]
  auditLogs     AuditLog[]
  parteTurno    ParteTurno?

  @@unique([date, shift])
}

// Horarios de los turnos (editables desde Configuración). Solo definen el turno
// POR DEFECTO al registrar; no re-asignan movimientos ya guardados.
model ShiftConfig {
  shift     Int      @id // 1 | 2
  startTime String // "HH:MM" (America/Bogota)
  endTime   String // "HH:MM"
  updatedAt DateTime @updatedAt
}

// Días de la semana en que el turno se queda fijo en 1 todo el día — no se sugiere el 2
// automáticamente por la hora (ej. domingo, si ese día solo se abre un turno). Editable
// desde Configuración; sigue siendo solo una SUGERENCIA, igual que ShiftConfig: quien
// registra puede cambiar a mano al turno 2 si de verdad lo necesita ese día.
// dayOfWeek: 0=domingo … 6=sábado (mismo criterio que Date#getUTCDay()).
model DiaTurnoUnico {
  dayOfWeek Int      @id
  activo    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model Movement {
  id            String  @id @default(cuid())
  businessDayId String
  businessDay   BusinessDay @relation(fields: [businessDayId], references: [id])

  // VENTA_FARMACIA | ABONO_CREDITO | RETIRO_CLIENTE | CONSIGNACION_CLIENTE | COMISION
  // | VENTA_FUXION | VENTA_LICORES_JHOANN | PAGO_FACTURA | GASTO_FARMACIA
  // | PENDIENTE_OTRO | IMPUESTO_4X1000
  type          String
  direction     String // INCOME | EXPENSE
  amount        Int // pesos colombianos (sin centavos)
  paymentMethod String // NEQUI | EFECTIVO
  note          String?

  registeredById String
  registeredBy   User     @relation(fields: [registeredById], references: [id])
  registeredAt   DateTime @default(now())

  isSystemGenerated     Boolean @default(false) // true para el 4x1000 automático
  // comisión -> retiro/consignación que la originó; impuesto -> movimiento que lo generó
  sourceMovementId      String?
  sourceMovement        Movement?  @relation("Derived", fields: [sourceMovementId], references: [id])
  derivedMovements      Movement[] @relation("Derived")
  needsReclassification Boolean    @default(false) // true si type=PENDIENTE_OTRO

  // Bolsillos organizativos: "COMISION", "LICORES_JHOANN", "FUXION", "BASE_FACTURAS", o null.
  // Entra: automático para VENTA_* + manual para GASTO/PAGO_FACTURA.
  // Sale: al marcar movimientos como pagados desde ese bolsillo.
  // NO afecta el cuadre de Nequi (puro organizativo).
  pettyCashBucket String?

  deletedAt DateTime? // soft delete: nunca se borra físicamente
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  auditLogs AuditLog[]

  @@index([businessDayId, deletedAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  movementId    String?
  movement      Movement? @relation(fields: [movementId], references: [id])
  businessDayId String?
  businessDay   BusinessDay? @relation(fields: [businessDayId], references: [id])
  action        String // CREATE | UPDATE | DELETE | CLOSE_DAY | REOPEN_DAY | SET_BASE
  changedById   String
  changedBy     User     @relation(fields: [changedById], references: [id])
  changedAt     DateTime @default(now())
  fieldChanges  String? // JSON { campo: { before, after } }

  @@index([changedAt])
}

// Historial de transferencias entre bolsillos (reclasificación interna, no afecta Nequi).
model PocketTransfer {
  id        String   @id @default(cuid())
  fromBucket String  // LICORES_JHOANN | FUXION | BASE_FACTURAS
  toBucket  String   // LICORES_JHOANN | FUXION | BASE_FACTURAS
  amount    Int
  createdById String
  createdBy User    @relation(fields: [createdById], references: [id])
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Base de trabajo para el servicio de retiros/consignaciones (registro único, id=1).
// La base total = efectivo + Nequi. El total solo cambia cuando el dueño lo edita;
// los retiros/consignaciones solo desplazan el reparto entre efectivo y Nequi.
model BaseFund {
  id           Int      @id @default(1)
  cashPortion  Int      @default(0)
  nequiPortion Int      @default(1110000)
  updatedAt    DateTime @updatedAt
}

// Saldo inicial manual por bolsillo (ajuste puntual del dueño, fuera de
// Movement/PocketTransfer). Solo existe fila para los bolsillos ajustados;
// los demás se tratan como 0 (ver getPockets()).
model PocketBalance {
  bucket          String   @id // COMISION | LICORES_JHOANN | FUXION | BASE_FACTURAS | PENDIENTE_OTRO
  openingBalance  Int      @default(0) // saldo inicial que cuenta como Nequi en el reparto por medio
  openingEfectivo Int      @default(0) // saldo inicial en efectivo (hoy solo lo usa Comisiones)
  updatedAt       DateTime @updatedAt
}

// ---------- Gastos clasificados por categoría (editable por el admin) ----------
// Antes compartida con "Cierre general" (retirado 2026-09-09); hoy la usa solo Parte de
// Turno / Cierre Diario.
model CategoriaGasto {
  id        String   @id @default(cuid())
  nombre    String   @unique
  // "Eliminar" desactiva si la categoría ya tiene gastos asociados (protege el histórico);
  // se borra físicamente solo si nunca se usó.
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())

  partesGastos ParteTurnoGasto[]
}

// ---------- Proveedores (Costo/facturas y Gastos, editable por el admin) ----------
// Un proveedor es de UN tipo (COSTO o GASTO); si el dueño necesita el mismo nombre en ambos
// contextos, crea dos registros (2026-07-15, confirmado con el dueño). "Eliminar" desactiva
// si el proveedor ya tiene facturas/gastos asociados (protege el histórico); se borra
// físicamente solo si nunca se usó (mismo patrón que CategoriaGasto). Antes compartido con
// "Cierre general" (retirado 2026-09-09); hoy lo usa solo Parte de Turno / Cierre Diario.
model Proveedor {
  id        String   @id @default(cuid())
  nombre    String
  tipo      String // COSTO | GASTO
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Cómo cobra habitualmente: al elegir este proveedor en el formulario de gastos/facturas,
  // se pre-selecciona este método (se puede cambiar).
  medioPagoHabitual String? // EFECTIVO_CAJA | EFECTIVO_SOBRE | NEQUI | DAVIPLATA | DATAFONO | TRANSFERENCIA | OTRO

  partesFacturas ParteTurnoFactura[] @relation("ProveedorPartesFacturas")
  partesGastos   ParteTurnoGasto[]   @relation("ProveedorPartesGastos")

  @@unique([nombre, tipo])
}

// ---------- Cuentas por cobrar por cliente ----------
model Cliente {
  id        String   @id @default(cuid())
  nombre    String
  telefono  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ventasCredito VentaCredito[]
  abonosCredito AbonoCredito[]
}

// date/shift son columnas sueltas (NO FK a BusinessDay a propósito): una venta a crédito se
// registra en cualquier momento del día, no atada al ciclo de apertura/cierre de turno de
// Nequi. El campo "Crédito" del Parte de Turno (venta por medio, de Dominium) sigue siendo un
// número de control aparte — no se fuerza a que cuadren exacto, son dos fuentes distintas.
// deletedAt = soft delete (mismo patrón que Movement), para poder editar/borrar sin perder auditoría.
model VentaCredito {
  id          String    @id @default(cuid())
  clienteId   String
  cliente     Cliente   @relation(fields: [clienteId], references: [id])
  monto       Int
  date        String // YYYY-MM-DD
  shift       Int // 1 | 2
  nota        String?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([clienteId])
  @@index([date])
}

model AbonoCredito {
  id          String    @id @default(cuid())
  clienteId   String
  cliente     Cliente   @relation(fields: [clienteId], references: [id])
  monto       Int
  medioPago   String // EFECTIVO | NEQUI | TARJETA | DAVIPLATA | TRANSFERENCIA | OTRO (nunca CREDITO)
  date        String
  shift       Int
  nota        String?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([clienteId])
  @@index([date])
}

// ============================================================================
// MÓDULO CIERRE MENSUAL (independiente de Nequi y de Cierre general, a propósito).
// Modelo simple alimentado día a día. El "disponible para gastar" se calcula en
// caliente (ver src/modules/mensual/calculations/cierreMensual.ts). Todo el dinero
// son enteros de pesos (COP). Cada mes arranca de cero (incl. cartera): el resumen
// solo suma las filas cuya `date` cae en el mes consultado.
// ============================================================================

// Categorías de gasto PROPIAS del módulo mensual (separadas de CategoriaGasto del
// Cierre general, por decisión 2026-07-15). "Eliminar" desactiva si ya tiene gastos.
model MensualCategoriaGasto {
  id        String   @id @default(cuid())
  nombre    String   @unique
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())

  gastos MensualGasto[]
}

// Una fila por día del mes (unique por fecha). La dueña la alimenta a diario:
// venta real, comisión 4% (escrita a mano), 4x1000 y el snapshot de cartera a esa fecha.
model MensualDia {
  id              String   @id @default(cuid())
  date            String   @unique // YYYY-MM-DD (America/Bogota)
  ventaDia        Int      @default(0) // venta real del día
  comisionTarjeta Int      @default(0) // 4% del banco sobre ventas con tarjeta
  impuesto4x1000  Int      @default(0) // 0.4% sobre transferencias que salen de su cuenta
  carteraTotal    Int      @default(0) // total de créditos a esa fecha (snapshot)
  nota            String?
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  gastos      MensualGasto[]
  diferencias MensualDiferencia[]

  @@index([date])
}

// Gasto itemizado del día (categoría + monto). El total del mes = suma de estos.
model MensualGasto {
  id           String                @id @default(cuid())
  mensualDiaId String
  mensualDia   MensualDia            @relation(fields: [mensualDiaId], references: [id], onDelete: Cascade)
  categoriaId  String
  categoria    MensualCategoriaGasto @relation(fields: [categoriaId], references: [id])
  monto        Int
  descripcion  String?
  createdAt    DateTime              @default(now())

  @@index([mensualDiaId])
}

// Sobrante/faltante de uno de los 3 cierres (Nequi/Efectivo/Banco) en un día.
// disposicion aplica solo a FALTANTE: CUBRE_EMPLEADA (no afecta disponible) o
// DESCUENTA_DISPONIBLE (resta). null = pendiente de decidir (aún no descuenta).
model MensualDiferencia {
  id           String     @id @default(cuid())
  mensualDiaId String
  mensualDia   MensualDia @relation(fields: [mensualDiaId], references: [id], onDelete: Cascade)
  cierre       String // NEQUI | EFECTIVO | BANCO
  tipo         String // SOBRANTE | FALTANTE
  monto        Int // siempre positivo; el signo lo da `tipo`
  disposicion  String? // CUBRE_EMPLEADA | DESCUENTA_DISPONIBLE (solo FALTANTE)
  nota         String?
  createdAt    DateTime   @default(now())

  @@index([mensualDiaId])
}

// ============================================================================
// MÓDULO LICORES (2026-07-19). Control de compra/venta de cervezas.
// Módulo AISLADO (como `mensual`), con una única integración deliberada con Nequi:
// una compra/venta pagada en NEQUI o EFECTIVO crea UN solo Movement ligado
// (movementId), para que el dueño no tenga que registrarlo dos veces. Los demás
// medios (tarjeta, Daviplata, transferencia, crédito) no tocan el cuadre Nequi.
// `movementId` es una columna suelta a propósito (sin relación Prisma): el módulo
// Nequi no se toca, y Movement usa soft-delete, así que no hay FK que mantener.
// ============================================================================

model LicorProducto {
  id          String   @id @default(cuid())
  nombre      String   @unique
  precioVenta Int      @default(0) // precio de venta ACTUAL; las ventas congelan el suyo
  stockMinimo Int      @default(6) // umbral de la alerta de stock bajo
  activo      Boolean  @default(true) // "eliminar" = desactivar (conserva el historial)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  compras LicorCompra[]
  ventas  LicorVenta[]
}

// Compra al proveedor (solo admin). El costo unitario se DERIVA: valorTotal / cantidad.
model LicorCompra {
  id          String        @id @default(cuid())
  productoId  String
  producto    LicorProducto @relation(fields: [productoId], references: [id])
  date        String // YYYY-MM-DD (America/Bogota)
  cantidad    Int
  valorTotal  Int // pesos pagados por TODA la compra
  proveedor   String?
  descripcion String?
  metodoPago  String // NEQUI | EFECTIVO | TARJETA | DAVIPLATA | TRANSFERENCIA | CREDITO
  movementId  String? // Movement (GASTO_FARMACIA) ligado; solo si metodoPago es NEQUI/EFECTIVO
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  deletedAt   DateTime? // soft delete

  // Cierre de licores que ya la contó (null = pendiente del próximo corte).
  licorCierreId String?
  licorCierre   LicorCierre? @relation(fields: [licorCierreId], references: [id], onDelete: SetNull)

  @@index([productoId, deletedAt])
  @@index([date])
  @@index([licorCierreId])
}

// Venta (la registra la vendedora desde el pop-up de "Venta Licores Jhoann").
// precioUnitario y costoUnitario quedan CONGELADOS: cambiar el precio del producto
// después no altera el margen ya registrado.
model LicorVenta {
  id             String        @id @default(cuid())
  productoId     String
  producto       LicorProducto @relation(fields: [productoId], references: [id])
  date           String // YYYY-MM-DD
  shift          Int // 1 | 2
  cantidad       Int
  precioUnitario Int // congelado al vender
  costoUnitario  Int // promedio ponderado de las compras a ese momento (congelado)
  metodoPago     String // NEQUI | EFECTIVO | TARJETA | DAVIPLATA | TRANSFERENCIA | CREDITO
  descuento      Boolean       @default(false) // true si se vendió a un precio distinto al de lista
  movementId     String? // Movement (VENTA_LICORES_JHOANN) ligado; solo NEQUI/EFECTIVO
  nota           String?
  createdById    String
  createdBy      User          @relation(fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  deletedAt      DateTime? // soft delete

  // Obligatorio SOLO cuando metodoPago = CREDITO: la cerveza salió fiada y hay que saber
  // a quién cobrarle. Cartera propia de licores, aparte de la de la farmacia.
  clienteId String?
  cliente   LicorCliente? @relation(fields: [clienteId], references: [id])

  licorCierreId String?
  licorCierre   LicorCierre? @relation(fields: [licorCierreId], references: [id], onDelete: SetNull)

  @@index([productoId, deletedAt])
  @@index([date])
  @@index([clienteId, deletedAt])
  @@index([licorCierreId])
}


// ---------------------------------------------------------------------------
// CARTERA DE LICORES (2026-07-19). Lista de clientes PROPIA, separada a propósito de
// `Cliente`/`VentaCredito` del Cierre general (decisión del dueño): nada de licores puede
// afectar la cartera de la farmacia. Saldo = Σ ventas a crédito − Σ abonos.
// ---------------------------------------------------------------------------

model LicorCliente {
  id        String   @id @default(cuid())
  nombre    String   @unique
  telefono  String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ventas LicorVenta[]
  abonos LicorAbono[]
}

// Pago de un cliente contra su deuda de cerveza. El medio se reduce a las 2 modalidades del
// cierre de licores (efectivo / plataforma), que es como el dueño lo maneja.
model LicorAbono {
  id          String       @id @default(cuid())
  clienteId   String
  cliente     LicorCliente @relation(fields: [clienteId], references: [id])
  date        String // YYYY-MM-DD
  monto       Int
  medioPago   String // EFECTIVO | PLATAFORMA
  nota        String?
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  deletedAt   DateTime?

  licorCierreId String?
  licorCierre   LicorCierre? @relation(fields: [licorCierreId], references: [id], onDelete: SetNull)

  @@index([clienteId, deletedAt])
  @@index([date])
  @@index([licorCierreId])
}

// ---------------------------------------------------------------------------
// CIERRE DE LICORES (2026-07-19). ESPORÁDICO: el dueño lo hace cuando quiere, no en una
// fecha fija. Cada cierre es un CORTE — se lleva todo lo que aún no había sido cerrado
// (ventas, compras y abonos con licorCierreId = null) y lo marca con su id. Así nada se
// cuenta dos veces aunque los cierres estén separados por semanas.
//
// Solo 2 modalidades (como lo maneja el dueño): EFECTIVO y PLATAFORMA (todo lo digital
// junto). El crédito queda aparte: esa plata todavía no entró.
// Se cuadra SOLO el efectivo contra el conteo físico; la plataforma es de referencia.
// Es una reconciliación propia de licores: NO altera el cuadre de Nequi.
// ---------------------------------------------------------------------------

model LicorCierre {
  id   String @id @default(cuid())
  date String // YYYY-MM-DD en que se hizo el corte

  // Fotos del periodo (se guardan para poder mostrar el histórico sin recalcular).
  ventasEfectivo   Int @default(0)
  ventasPlataforma Int @default(0)
  ventasCredito    Int @default(0) // informativo: salió cerveza, entró deuda
  abonosEfectivo   Int @default(0)
  abonosPlataforma Int @default(0)
  comprasEfectivo  Int @default(0)
  comprasPlataforma Int @default(0)

  efectivoEsperado Int @default(0) // ventas efectivo + abonos efectivo − compras efectivo
  efectivoContado  Int @default(0) // lo que el dueño contó físicamente
  diferencia       Int @default(0) // contado − esperado (+ sobró / − faltó)

  nota        String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  ventas  LicorVenta[]
  compras LicorCompra[]
  abonos  LicorAbono[]

  @@index([date])
}

// ============================================================================
// MÓDULO PARTE DE TURNO (2026-07-29; desacoplado de Cierre General el 2026-09-09). La
// vendedora registra al cambio de turno el "Cuadre de Caja" que ya genera en Dominium
// (venta por medio de pago, retiro, facturas y gastos); el ADMINISTRADOR lo aprueba.
//
// Desde 2026-09-09 aprobar NO vuelca nada a ningún otro lado: los gastos/facturas son
// filas reales de ParteTurnoGasto/ParteTurnoFactura desde que la vendedora las agrega,
// y Cierre Diario lee la venta directo de estas filas (cierreDiario/queries →
// getVentasDelDia). Aprobar solo BLOQUEA el parte (ya no se edita ni se devuelve) y deja
// constancia en AuditLog.
//
// Flujo de datos de UNA SOLA DIRECCIÓN: el módulo Nequi ALIMENTA el parte (pre-llena
// y contrasta la venta, vía getDaySummary), pero este módulo NUNCA escribe en Nequi
// —ni un Movement—. Regla dura del proyecto, confirmada por el dueño.
// ============================================================================

model ParteTurno {
  id            String      @id @default(cuid())
  businessDayId String      @unique // un parte por turno
  businessDay   BusinessDay @relation(fields: [businessDayId], references: [id])

  // BORRADOR: la vendedora lo está llenando · ENVIADO: lo mandó, espera al admin ·
  // APROBADO: bloqueado, histórico de solo lectura (aprobar no vuelca nada, ver arriba).
  // "Devolver" regresa a BORRADOR con notaAdmin — a propósito NO hay estado RECHAZADO,
  // que sería un callejón sin salida.
  estado String @default("BORRADOR")

  // Venta por medio de pago, copiada del recibo del POS.
  ventaEfectivo      Int @default(0)
  ventaNequi         Int @default(0)
  ventaTarjeta       Int @default(0) // Tarjeta Crédito
  ventaTarjetaDebito Int @default(0) // Cierre Diario (2026-09-09): antes iba mezclada con ventaTarjeta
  ventaDaviplata     Int @default(0)
  ventaTransferencia Int @default(0)
  ventaCredito       Int @default(0)
  ventaOtro          Int @default(0)
  // DEPRECADO (2026-09-09): ya no se digita en el parte — resto del Cierre General 70/30,
  // retirado al alinear la pantalla con .claude/PLAN-CIERRE-DIARIO-IMPLEMENTACION.md. La
  // columna se conserva intacta (regla dura: nunca DROP); queda en 0 para partes nuevos.
  ventaSinFactura    Int @default(0)

  // DEPRECADO (2026-09-09): igual que ventaSinFactura. Era el efectivo retirado al cerrar,
  // que iba al "sobre blanco" de Saldos por plataforma (módulo retirado con Cierre General).
  retiroCierre Int     @default(0)
  realEfectivo Int? // efectivo contado físicamente en la caja principal
  nota         String?
  notaAdmin    String? // por qué el admin lo devolvió

  registradoById String
  registradoBy   User   @relation("ParteRegistradoPor", fields: [registradoById], references: [id])

  enviadoAt    DateTime?
  aprobadoAt   DateTime?
  aprobadoById String?
  aprobadoBy   User?     @relation("ParteAprobadoPor", fields: [aprobadoById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gastoItems   ParteTurnoGasto[]
  facturaItems ParteTurnoFactura[]

  @@index([estado])
}

// proveedorId es NOT NULL: esta tabla nace después de la regla de "proveedor obligatorio"
// (2026-07-19) y la vendedora SIEMPRE elige de la lista — no puede crear proveedores.
model ParteTurnoGasto {
  id           String         @id @default(cuid())
  parteTurnoId String
  parteTurno   ParteTurno     @relation(fields: [parteTurnoId], references: [id], onDelete: Cascade)
  categoriaId  String
  categoria    CategoriaGasto @relation(fields: [categoriaId], references: [id])
  proveedorId  String
  proveedorRef Proveedor      @relation("ProveedorPartesGastos", fields: [proveedorId], references: [id])
  monto        Int
  descripcion  String?
  metodoPago   String? // METODOS_PAGO_ITEM_MANUAL (null = EFECTIVO_CAJA)
  createdAt    DateTime       @default(now())

  @@index([parteTurnoId])
}

model ParteTurnoFactura {
  id           String     @id @default(cuid())
  parteTurnoId String
  parteTurno   ParteTurno @relation(fields: [parteTurnoId], references: [id], onDelete: Cascade)
  proveedorId  String
  proveedorRef Proveedor  @relation("ProveedorPartesFacturas", fields: [proveedorId], references: [id])
  monto        Int
  descripcion  String?
  metodoPago   String? // METODOS_PAGO_ITEM_MANUAL (null = EFECTIVO_CAJA)
  createdAt    DateTime   @default(now())

  @@index([parteTurnoId])
}

// ============================================================================
// MÓDULO CIERRE DIARIO (2026-09-09). Reemplaza a "Cierre general": concilia lo que Dominium
// (vía Parte de Turno) registró como vendido en Cuenta Corriente y Daviplata contra el dinero
// real observado en el banco. A nivel de DÍA calendario, no de turno (el banco no distingue
// turnos) — por eso no tiene relación a BusinessDay, igual que VentaCredito/AbonoCredito.
// Ver .claude/PROCESO-CIERRE-DIARIO.md para el proceso completo.
// ============================================================================

model CierreDiario {
  date               String    @id // YYYY-MM-DD
  // El "saldo confirmado ayer" NO se guarda: se deriva del saldoRealCC de la confirmación
  // anterior (getUltimaConfirmacionCC). Así la cadena tolera días sin confirmar: el esperado
  // suma los movimientos de TODO el hueco desde la última confirmación hasta hoy.
  saldoRealCC        Int? // saldo real observado hoy en el banco (Cuenta Corriente)
  notaCC             String? // explicación cuando la diferencia de CC es real
  saldoRealDaviplata Int? // saldo real observado hoy en Daviplata
  notaDaviplata      String?
  cerradoById        String?
  cerradoBy          User?     @relation(fields: [cerradoById], references: [id])
  cerradoAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// Cierre de lote del datáfono (una vez al día, no por turno): desglose de tarjeta por
// franquicia. Dominium solo da el total combinado; el datáfono es el único que separa.
model CierreDiarioDatafono {
  date      String   @id // YYYY-MM-DD
  createdAt DateTime @default(now())

  franquicias CierreDiarioDatafonoFranquicia[]
}

model CierreDiarioDatafonoFranquicia {
  id           String               @id @default(cuid())
  datafonoDate String
  datafono     CierreDiarioDatafono @relation(fields: [datafonoDate], references: [date], onDelete: Cascade)
  franquicia   String // FRANQUICIAS (cierreDiario/types.ts): VISA | MASTERCARD | OTRA
  montoVendido Int

  @@index([datafonoDate])
}

// Tarjeta vendida un día que todavía no ha llegado al banco (1-2 días hábiles). Se calza
// (aproximado, ~4% de comisión variable, nunca exacto) contra la consignación real, por
// franquicia, cuando llega.
model CierreDiarioPendienteTarjeta {
  id              String   @id @default(cuid())
  dateOrigen      String // YYYY-MM-DD en que se vendió
  franquicia      String
  montoVendido    Int
  montoConsignado Int?
  fechaConsignado String? // YYYY-MM-DD
  resuelto        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([dateOrigen])
  @@index([resuelto])
}

// Movimientos que Dominium no conoce (arriendo, nómina, retiros, cuotas de manejo,
// transferencias entre cuentas propias) — antes se llevaban de memoria. El 4x1000 solo
// aplica a egresos de CUENTA_CORRIENTE (Daviplata no lo paga).
model CierreDiarioMovimientoManual {
  id             String   @id @default(cuid())
  date           String // YYYY-MM-DD
  descripcion    String
  tipo           String // INGRESO | EGRESO
  cuenta         String // CUENTA_CORRIENTE | DAVIPLATA
  monto          Int
  impuesto4x1000 Int      @default(0)
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())

  @@index([date])
}

// ============================================================================
// MÓDULO FUXION (2026-08-20). Módulo NUEVO e INDEPENDIENTE, mismo patrón aislado que
// `licores` y `mensual`. Controla la mercancía de Fuxion (sobres), que hasta hoy solo
// existía como plata: el movimiento `VENTA_FUXION` y el bolsillo `FUXION` ya existían en
// el módulo Nequi, pero nadie sabía qué producto se vendió ni cuántos quedaban.
//
// Decisiones del dueño (2026-08-20):
//   - Solo FUXION. Los suplementos (Ensure/Glucerna) quedan FUERA del alcance.
//   - El proveedor (Kenny) es un proveedor normal: el valor de la compra SE DIGITA.
//     No se modela precio de lista ni descuento; el costo unitario se deriva.
//   - La bolsa trae 28 sobres: valor PRECARGADO pero editable (hubo una de 7).
//   - La compra a crédito se paga COMPLETA, de una sola vez → no hay abonos parciales,
//     por eso el pago vive como 3 columnas en FuxionCompra y no como tabla aparte.
//   - Se arranca de CERO: por eso `inventarioInicial` (Licores no lo tiene, empezó en 0).
// ============================================================================

model FuxionProducto {
  id     String @id @default(cuid())
  nombre String @unique

  precioVenta       Int     @default(0) // precio ACTUAL; las ventas congelan el suyo
  inventarioInicial Int     @default(0) // conteo físico al arrancar el módulo
  stockMinimo       Int     @default(6) // umbral de la alerta de stock bajo
  activo            Boolean @default(true) // "eliminar" con historial = desactivar

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  compras FuxionCompra[]
  ventas  FuxionVenta[]
}

// Compra al proveedor (solo admin). El costo unitario se DERIVA: valorTotal / cantidad.
model FuxionCompra {
  id         String         @id @default(cuid())
  productoId String
  producto   FuxionProducto @relation(fields: [productoId], references: [id])

  date        String // YYYY-MM-DD (America/Bogota)
  cantidad    Int     @default(28) // una bolsa; editable
  valorTotal  Int // pesos que se pagan por TODA la compra (se digita)
  proveedor   String? // "Kenny"
  descripcion String?
  metodoPago  String // NEQUI | EFECTIVO | CREDITO
  movementId  String? // Movement (GASTO_FARMACIA) ligado; solo si NEQUI/EFECTIVO

  // Deuda con el proveedor. Solo aplica a las compras con metodoPago = CREDITO: la bolsa
  // se paga COMPLETA cuando se termina de vender, así que basta con marcarla pagada.
  pagadaAt       String? // YYYY-MM-DD; null = todavía se le debe
  pagoMetodoPago String? // EFECTIVO | NEQUI
  pagoMovementId String? // Movement (GASTO_FARMACIA) del pago; sale plata de la caja

  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  deletedAt   DateTime? // soft delete

  fuxionCierreId String?
  fuxionCierre   FuxionCierre? @relation(fields: [fuxionCierreId], references: [id], onDelete: SetNull)

  @@index([productoId, deletedAt])
  @@index([date])
  @@index([fuxionCierreId])
}

// Venta (la registra la vendedora desde el pop-up de "Venta Fuxion").
// precioUnitario y costoUnitario quedan CONGELADOS: cambiar el precio del producto después
// no altera el margen ya registrado.
model FuxionVenta {
  id         String         @id @default(cuid())
  productoId String
  producto   FuxionProducto @relation(fields: [productoId], references: [id])

  date           String // YYYY-MM-DD
  shift          Int // 1 | 2
  cantidad       Int
  precioUnitario Int // congelado al vender
  costoUnitario  Int // promedio ponderado de las compras a ese momento (congelado)
  metodoPago     String // NEQUI | EFECTIVO | TARJETA | DAVIPLATA | TRANSFERENCIA | CREDITO
  descuento      Boolean @default(false) // true si se vendió a un precio distinto al de lista
  movementId     String? // Movement (VENTA_FUXION) ligado; solo NEQUI/EFECTIVO
  nota           String?

  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  // Obligatorio SOLO cuando metodoPago = CREDITO. Cartera propia de Fuxion, aparte de la de
  // la farmacia y de la de licores.
  clienteId String?
  cliente   FuxionCliente? @relation(fields: [clienteId], references: [id])

  fuxionCierreId String?
  fuxionCierre   FuxionCierre? @relation(fields: [fuxionCierreId], references: [id], onDelete: SetNull)

  @@index([productoId, deletedAt])
  @@index([date])
  @@index([clienteId, deletedAt])
  @@index([fuxionCierreId])
}

model FuxionCliente {
  id        String   @id @default(cuid())
  nombre    String   @unique
  telefono  String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ventas FuxionVenta[]
  abonos FuxionAbono[]
}

// Pago de un cliente contra su deuda de Fuxion. Solo 2 medios, iguales a las modalidades
// del cierre. NO crea Movement en Nequi: el corte de Fuxion ya lo cuenta.
model FuxionAbono {
  id        String        @id @default(cuid())
  clienteId String
  cliente   FuxionCliente @relation(fields: [clienteId], references: [id])

  date      String // YYYY-MM-DD
  monto     Int
  medioPago String // EFECTIVO | PLATAFORMA
  nota      String?

  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  fuxionCierreId String?
  fuxionCierre   FuxionCierre? @relation(fields: [fuxionCierreId], references: [id], onDelete: SetNull)

  @@index([clienteId, deletedAt])
  @@index([date])
  @@index([fuxionCierreId])
}

// Cierre de Fuxion: ESPORÁDICO, modelo de CORTE (idéntico a LicorCierre). Se lleva todo lo
// que tenga fuxionCierreId = null y lo marca POR ID dentro de la transacción.
model FuxionCierre {
  id   String @id @default(cuid())
  date String // YYYY-MM-DD en que se hizo el corte

  ventasEfectivo    Int @default(0)
  ventasPlataforma  Int @default(0)
  ventasCredito     Int @default(0) // informativo: salió mercancía, entró deuda
  abonosEfectivo    Int @default(0)
  abonosPlataforma  Int @default(0)
  comprasEfectivo   Int @default(0)
  comprasPlataforma Int @default(0)
  pagosEfectivo     Int @default(0) // pagos al proveedor hechos en efectivo
  pagosPlataforma   Int @default(0)

  efectivoEsperado Int @default(0) // ventas ef. + abonos ef. − compras ef. − pagos ef.
  efectivoContado  Int @default(0)
  diferencia       Int @default(0) // contado − esperado (+ sobró / − faltó)

  nota        String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  ventas  FuxionVenta[]
  compras FuxionCompra[]
  abonos  FuxionAbono[]

  @@index([date])
}
